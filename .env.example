# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values according to your environment
# Never commit the actual .env file to version control

# Application Environment
NODE_ENV=development
PORT=3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/your_db_name?schema=public"

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret - Use a strong, randomly generated secret in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Bcrypt salt rounds (10-12 recommended for production)
BCRYPT_SALT_ROUNDS=10

# =============================================================================
# OAUTH PROVIDERS (Optional - Remove if not using)
# =============================================================================
# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (if implementing)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# RATE LIMITING & THROTTLING
# =============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# Database query logging (security consideration)
# Set to 'true' only in development or when debugging is necessary
# Queries will be sanitized to remove sensitive data patterns
LOG_DATABASE_QUERIES=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# =============================================================================
# EMAIL SERVICE (Optional - Configure if using email notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# REDIS CONFIGURATION (Optional - For caching/sessions)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=5242880
UPLOAD_DEST=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# =============================================================================
# API DOCUMENTATION
# =============================================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api

# =============================================================================
# INTERCEPTORS CONFIGURATION
# =============================================================================
# Response Interceptor - Standardizes API response format
INTERCEPTOR_RESPONSE_ENABLED=true
INTERCEPTOR_RESPONSE_TIMESTAMP=false
INTERCEPTOR_RESPONSE_REQUEST_ID=false
INTERCEPTOR_RESPONSE_SERVER_INFO=false
INTERCEPTOR_RESPONSE_WRAP_VALUES=true
INTERCEPTOR_RESPONSE_SUCCESS_MESSAGE=
INTERCEPTOR_RESPONSE_EXCLUDE_ROUTES=

# Logging Interceptor - Logs HTTP requests and responses
INTERCEPTOR_LOGGING_ENABLED=true
INTERCEPTOR_LOGGING_REQUESTS=true
INTERCEPTOR_LOGGING_RESPONSES=false
INTERCEPTOR_LOGGING_SANITIZE=true
INTERCEPTOR_LOGGING_HEADERS=false
INTERCEPTOR_LOGGING_QUERY_PARAMS=true
INTERCEPTOR_LOGGING_USER_INFO=true
INTERCEPTOR_LOGGING_PERFORMANCE=true
INTERCEPTOR_LOGGING_MAX_BODY_LENGTH=1000
INTERCEPTOR_LOGGING_EXCLUDE_ROUTES=

# Timeout Interceptor - Prevents hanging requests
INTERCEPTOR_TIMEOUT_ENABLED=false
INTERCEPTOR_TIMEOUT_MS=30000
INTERCEPTOR_TIMEOUT_MESSAGE=
INTERCEPTOR_TIMEOUT_EXCLUDE_ROUTES=

# Transform Interceptor - Cleans and transforms response data
INTERCEPTOR_TRANSFORM_ENABLED=false
INTERCEPTOR_TRANSFORM_REMOVE_NULL=false
INTERCEPTOR_TRANSFORM_REMOVE_UNDEFINED=false
INTERCEPTOR_TRANSFORM_TRIM=true
INTERCEPTOR_TRANSFORM_LOWERCASE_EMAIL=true
INTERCEPTOR_TRANSFORM_STANDARDIZE_DATES=true
INTERCEPTOR_TRANSFORM_REMOVE_EMPTY=false
INTERCEPTOR_TRANSFORM_CONVERT_NUMBERS=false

# Error Interceptor - Standardizes error responses
INTERCEPTOR_ERROR_ENABLED=true
INTERCEPTOR_ERROR_STACK_TRACE=false
INTERCEPTOR_ERROR_LOG_ERRORS=true
INTERCEPTOR_ERROR_TRANSFORM_VALIDATION=true
INTERCEPTOR_ERROR_INCLUDE_CONTEXT=true

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
METRICS_DEFAULT_ENABLED=true
METRICS_HTTP_ENABLED=true
METRICS_DATABASE_ENABLED=false
METRICS_MEMORY_ENABLED=false
METRICS_MEMORY_INTERVAL=30
METRICS_PREFIX=

# Application Info
APP_NAME=Your App Name
APP_VERSION=1.0.0
APP_DESCRIPTION=Your app description

# =============================================================================
# THIRD-PARTY SERVICES (Configure as needed)
# =============================================================================
# AWS S3 (if using file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# SendGrid (if using for emails)
SENDGRID_API_KEY=your-sendgrid-api-key

# Stripe (if implementing payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
