# =============================================================================
# Docker Environment Variables
# =============================================================================
# This file contains environment variables for Docker Compose
# Copy this to .env.docker and update values as needed

# Application
NODE_ENV=production
PORT=3000
APP_NAME=Your App Name

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=your-secure-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT
JWT_SECRET=your-super-secret-jwt-key-for-docker

# Other configurations can be added here
